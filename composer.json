{
    "type": "project",
    "name": "example/symfony-base",
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.3",
        "symfony/runtime": "^6.3",
        "symfony/http-client": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
